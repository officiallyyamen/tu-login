{
  "manifest_version": 3,
  "name": "TU Login 2FA",
  "version": "1.2.0",
  "description": "Logs in to the TU Wien login page (idp.zid.tuwien.ac.at) automatically: username, password, 2FA code.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://idp.zid.tuwien.ac.at/*"],
      "js": ["totp.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://tuwel.tuwien.ac.at/login/*"],
      "js": ["tuwel.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "TU Login 2FA" }
}
